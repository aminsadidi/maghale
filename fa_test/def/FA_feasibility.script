// Feasibility test: FAPbI3 with Cu2O / NiOx / bilayer HTL and back-contact work function
set errorhandling.overwritefile
clear all
clear actions
action light
action workingpoint.temperature 300
action iv.doiv
action iv.startv 0
action iv.stopv 1.3
action iv.increment 0.02
action iv.stopaftervoc 1
load definitionfile FA_Cu2O_WF45.def
calculate singleshot
save results.iv MG_FA_Cu2O_WF45.iv
