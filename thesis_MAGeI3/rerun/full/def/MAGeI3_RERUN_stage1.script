// MAGeI3 thesis - re-simulation stage 1 (steps 1-3) with sourced parameters
set errorhandling.overwritefile
clear all
clear actions
action light
action workingpoint.temperature 300
action iv.doiv
action iv.startv 0
action iv.stopv 2.0
action iv.increment 0.02
action iv.stopaftervoc 1
// step 1: absorber 100..800 nm (TiO2 100, Spiro 100)
load definitionfile 10_RERUN_noBuffer.def
set layer1.thickness 0.1
set layer2.thickness 0.1
set layer3.thickness 0.1
calculate singleshot
save results.iv MG_R1_S1_abs100.iv
load definitionfile 10_RERUN_noBuffer.def
set layer1.thickness 0.1
set layer2.thickness 0.2
set layer3.thickness 0.1
calculate singleshot
