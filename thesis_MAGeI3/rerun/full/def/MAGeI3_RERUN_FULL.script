// MAGeI3 thesis - complete re-simulation (part A + part B) with sourced parameters; outputs MG_F_*
set errorhandling.overwritefile
clear all
// ===== A1: absorber 250, 350 nm (TiO2 100, Spiro 100)
clear actions
action light
action workingpoint.temperature 300
action iv.doiv
action iv.startv 0
action iv.stopv 2.0
action iv.increment 0.02
action iv.stopaftervoc 1
load definitionfile 10_RERUN_noBuffer.def
set layer1.thickness 0.1
set layer2.thickness 0.25
set layer3.thickness 0.1
calculate singleshot
save results.iv MG_F_A1_abs250.iv
load definitionfile 10_RERUN_noBuffer.def
set layer1.thickness 0.1
set layer2.thickness 0.35
set layer3.thickness 0.1
calculate singleshot
save results.iv MG_F_A1_abs350.iv
// ===== A2: TiO2 thickness at absorber 300 nm (Spiro 100)
load definitionfile 10_RERUN_noBuffer.def
set layer1.thickness 0.1
set layer2.thickness 0.3
set layer3.thickness 0.001
calculate singleshot
save results.iv MG_F_A2_etl001.iv
